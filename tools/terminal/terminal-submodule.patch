+        /**
+         * Maps the device's primary Android ABI to the Ubuntu/Debian architecture
+         * name used in the rootfs asset filename.
+         */
+        private fun ubuntuArchForDevice(): String {
+            val abi = Build.SUPPORTED_ABIS.firstOrNull() ?: "arm64-v8a"
+            return when (abi) {
+                "arm64-v8a" -> "aarch64"
+                "armeabi-v7a" -> "armhf"
+                "x86_64" -> "amd64"
+                "x86" -> "i386"
+                else -> "aarch64"
+            }
+        }
+
+        // Ubuntu rootfs asset is selected at runtime based on device ABI so that
+        // 32-bit ARM devices get an armhf rootfs instead of the arm64 one.
+        private val UBUNTU_FILENAME: String
+            get() = "ubuntu-noble-${ubuntuArchForDevice()}-pd-v4.18.0.tar.xz"
+
